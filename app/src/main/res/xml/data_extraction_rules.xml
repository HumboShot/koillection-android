<?xml version="1.0" encoding="utf-8"?>
<!-- Used on Android 12 and higher. The login data is encrypted with a Keystore key that is
     never backed up or transferred, so a copy cannot be read. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="koillection_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="koillection_auth.xml" />
    </device-transfer>
</data-extraction-rules>
